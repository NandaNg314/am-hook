# Apple Music Decrypt Server (am-hook)
LISTEN=127.0.0.1:31408
PORT=31408
AUTH_PASSWORD=your_auth_password_here
WRAPPER_URL=http://127.0.0.1:12340

# Cloud Transfer Service (cloud-service.mjs)
CLOUD_PORT=31409
CLOUD_HOST=127.0.0.1
HOOK_BASE=http://127.0.0.1:31408
WRAPPER_BASE=http://127.0.0.1:12340
CLOUD_CONCURRENCY=2
HLS_SEG_CONCURRENCY=8
MIN_FREE_DISK_GB=8
WEB_DAILY_TRACK_QUOTA=200
OWNER_IPS=127.0.0.1,your_static_ip
ADMIN_KEY=your_admin_secret_key
ALLOWED_ORIGINS=

# Widevine / CENC Fallback (optional, defaults under repo tools/ and target/release/)
# WV_PY=/home/ubuntu/am-hook/tools/wv_env/bin/python
# WV_KEY_SCRIPT=/home/ubuntu/am-hook/tools/wv/get_wv_key.py
# CENC_TOOL_PATH=/home/ubuntu/am-hook/target/release/cenc-tool

# Telegram Bot Configuration (tg-bot.mjs)
BOT_TOKEN=your_telegram_bot_token_here
TG_API_BASE=http://127.0.0.1:8081
CLOUD_API=http://127.0.0.1:31409/api/cloud-transfer
OWNER_USER_ID=your_telegram_user_id
AUTHORIZED_GROUP_ID=-100xxxxxxxxxx
