# Apple Music Decrypt Server (am-hook)
PORT=31408
AUTH_PASSWORD=your_auth_password_here
WRAPPER_URL=http://127.0.0.1:12340
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
TG_API_BASE=http://127.0.0.1:8081
OWNER_USER_ID=your_telegram_user_id
AUTHORIZED_GROUP_ID=-100xxxxxxxxxx

# Cloud Service & Rate Limiting
CLOUD_PORT=31409
CLOUD_HOST=127.0.0.1
OWNER_IPS=127.0.0.1,your_static_ip
ADMIN_KEY=your_admin_secret_key
